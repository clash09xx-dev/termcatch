# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database ──────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
# Use "Transaction" mode for serverless (port 6543)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Use "Session" mode for migrations (port 5432)
DIRECT_URL=postgresql://postgres.your-project:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── Stripe ────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Subscription Price IDs (recurring monthly, PLN) — create the products/prices
# in the Stripe Dashboard, then paste the price_… IDs here. Without them,
# subscription billing shows an honest "Płatności są jeszcze konfigurowane"
# state (no fake checkout). Standard trial = 7 days.
#   SOLO 99 / TEAM 199 / SALON_PRO 369 / ULTIMATE 499 PLN per month.
STRIPE_PRICE_SOLO=price_...
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_SALON_PRO=price_...
STRIPE_PRICE_ULTIMATE=price_...
# WELCOME promo (first 3 months free, first 100 salons). Create a COUPON in the
# Stripe Dashboard — 100% off, duration = repeating, duration_in_months = 3 —
# and paste its id here. The 100-redemption cap + one-per-business/owner/customer
# limit are enforced by our own ledger, NOT by a public Stripe promotion code.
# Leave unset to disable WELCOME (registrations then get the normal 7-day trial).
STRIPE_COUPON_WELCOME=

# ── Feature flags (plan/architecture rollout) ─────────────────────
# Plan-limit enforcement (employees + locations). OFF by default so existing
# salons are NEVER blocked before billing assigns real plans. Even when "true",
# limits apply ONLY to a business with an explicitly-assigned Stripe
# subscription — grandfathered/FREE salons stay unlimited. Flip to "true" only
# after Stripe billing is live (Prompt 3).
ENTITLEMENTS_ENFORCED=false
# Multi-location (Location model, branch management, active-location context).
# OFF by default; the app runs as single-location. Enable ONLY after: (1)
# `prisma db push` creates the tables, (2) `npx tsx scripts/backfill-locations.ts
# --commit` seeds a primary location per business. No code queries the Location
# tables while this is off.
MULTI_LOCATION_ENABLED=false

# ── OpenAI / AI assistant ─────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
# Without a real key the AI features are inert (the app stays fully usable);
# deterministic insights still work, generative AI shows an honest "not
# configured" state. Never exposed to the browser.
OPENAI_API_KEY=sk-...
# Three model tiers so we never hardcode an expensive model into every request:
#   FAST     — generation/classification (review replies, campaign copy)
#   STANDARD — normal business-assistant questions
#   SMART    — deep multi-dataset analysis (Professional-capped, Ultimate fair-use)
AI_MODEL_FAST=gpt-4o-mini
AI_MODEL_STANDARD=gpt-4o-mini
AI_MODEL_SMART=gpt-4o
# Deep-analysis (SMART) daily allowance. Professional is intentionally capped at
# 3/day (4th → upgrade to Ultimate); Ultimate is high fair-use. Overridable:
# AI_DEEP_LIMIT_BASIC=3
# AI_DEEP_LIMIT_UNLIMITED=50
# HARD monthly AI cost cap per business (USD), ALL plans, independent of daily
# limits. Computed server-side from the usage ledger over the active billing
# period (Stripe current_period_start, else calendar month). Blocks BEFORE any
# paid OpenAI call once reached. Default 60.
AI_MONTHLY_COST_CAP_USD=60
# Kill switch (defaults ON). Set to "false" to disable all AI features globally.
# AI_ENABLED=true
# Cost protection (all optional — sensible defaults applied):
#   AI_MAX_OUTPUT_TOKENS   hard cap on output tokens per request (default 1200)
#   AI_MAX_CONTEXT_CHARS   cap on the business-context block sent (default 12000)
#   AI_DAILY_LIMIT_BASIC   Professional daily request cap (default 30 — margin)
#   AI_DAILY_LIMIT_UNLIMITED  Ultimate anti-abuse ceiling (default 500 — feels
#                             unlimited to any real salon; only scripts hit it)
# AI_MAX_OUTPUT_TOKENS=1200
# AI_DAILY_LIMIT_BASIC=30
# AI_DAILY_LIMIT_UNLIMITED=500

# ── Fakturownia (invoicing) ───────────────────────────────────────
# Official API: https://app.fakturownia.pl/api . The token is server-side only
# and is NEVER sent to the browser. Set both to enable the "Wystaw fakturę"
# button on /business/invoices and the AI invoice flow.
#   FAKTUROWNIA_ACCOUNT_DOMAIN is the "<domain>" in <domain>.fakturownia.pl
FAKTUROWNIA_API_TOKEN=
FAKTUROWNIA_ACCOUNT_DOMAIN=
# Default VAT rate (%) applied to invoice positions. Default 23.
# FAKTUROWNIA_DEFAULT_TAX=23

# ── Employee accounts ─────────────────────────────────────────────
# Optional HMAC secret for employee-invitation tokens. Falls back to
# SUPABASE_SERVICE_ROLE_KEY if unset. Set a dedicated value in production.
# INVITE_TOKEN_SECRET=

# ── Resend (Email) ────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM=TermCatch <no-reply@termcatch.com>
EMAIL_REPLY_TO=hello@termcatch.com

# ── Twilio (SMS / WhatsApp) ───────────────────────────────────────
# Get from: https://console.twilio.com
# Outbound SMS authenticates with an API Key (Console → Account → API keys & tokens).
TWILIO_ACCOUNT_SID=AC...
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=...
# PREFERRED sender. When set, ALL normal SMS is sent via this Messaging Service,
# so Twilio presents the `TermCatch` Alphanumeric Sender ID to Polish networks
# (and falls back on its side to the US number in the Sender Pool where alpha
# senders aren't allowed). This is what stops PL carriers showing `Info`.
TWILIO_MESSAGING_SERVICE_SID=MG...
# LEGACY FALLBACK only — used solely when TWILIO_MESSAGING_SERVICE_SID is unset.
# A bare foreign (US) number is typically relabelled to a generic `Info` in PL.
TWILIO_FROM_NUMBER=+1...
# Auth Token is NO LONGER used for sending — kept only to validate inbound
# Twilio webhook signatures (/api/sms/status) and the disabled WhatsApp path.
TWILIO_AUTH_TOKEN=...
# SMS_ENABLED is the single launch kill-switch for automated transactional SMS.
# (There is intentionally no second TWILIO_ENABLED flag.)
# SMS_ENABLED=true
# WhatsApp is not part of the launch; disabled unless WHATSAPP_ENABLED=true.
# TWILIO_WHATSAPP_FROM is a WhatsApp sender ONLY — never used for SMS.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Google Maps ───────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# ── Upstash Redis (rate limiting, caching) ────────────────────────
# Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ── Google Calendar sync (optional) ───────────────────────────────
# A SEPARATE OAuth client from "Sign in with Google": that login runs through
# Supabase Auth, so its token carries no Calendar scopes and no refresh token
# we control. Create a Web application client at
#   https://console.cloud.google.com → APIs & Services → Credentials
# with the Google Calendar API enabled, and add this exact redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/integrations/google-calendar/callback
# Scopes requested (least privilege):
#   .../auth/calendar.readonly        — list calendars + FreeBusy
#   .../auth/calendar.events.owned    — only events this app created
# Leave both blank to keep the feature off; everything degrades to
# TermCatch-only availability.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Encryption key for integration secrets at rest (Google refresh tokens) and
# for signing the OAuth `state`. Falls back to SUPABASE_SERVICE_ROLE_KEY when
# unset. Set GOOGLE_CALENDAR_ENCRYPTION_KEY to give calendar tokens their own
# key; rotating it forces every salon to reconnect.
# INTEGRATION_ENCRYPTION_KEY=
# GOOGLE_CALENDAR_ENCRYPTION_KEY=
